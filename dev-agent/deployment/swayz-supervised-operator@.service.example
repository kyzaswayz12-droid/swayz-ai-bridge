# Review and install explicitly as a root-owned unit; not enabled by GitHub.
# Start only from an authenticated operator session with an independently
# prepared job ID. AI service identities must have no systemctl privilege.
[Unit]
Description=Swayz operator supervised signed execution for %i
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/swayz/activation-stage/dev-agent
Environment=PYTHONPATH=/opt/swayz/activation-stage/dev-agent
ExecStart=/opt/swayz/control-venv/bin/python -m agent.supervised_operator_entrypoint --job %i
ExecStopPost=/opt/swayz/control-venv/bin/python -m agent.restore_emergency_stop
TimeoutStartSec=420
RuntimeMaxSec=420
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/swayzcontrol/state /var/lib/swayz-executor
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
